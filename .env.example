# Local run (optional). In GitHub Actions these come from workflow_dispatch
# inputs (Tracera Run in CI) + repository secrets.
TRACERA_BASE_URL=http://127.0.0.1:8080
TRACERA_PROJECT_ID=50
TRACERA_AUTOTEST_TOKEN=
# Omit for owned-run mode; set when attaching to a Tracera-created run:
# TRACERA_TEST_RUN_ID=
TRACERA_LOG_LEVEL=debug
